# Bigin CRM / Zoho OAuth Credentials
# -------------------------------------------------
# 1. Go to https://api-console.zoho.com/
# 2. Create a "Self Client" application
# 3. Generate a refresh token with these scopes:
#      ZohoBigin.modules.ALL
#      ZohoBigin.settings.ALL
# 4. Fill in the values below

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Zoho data center domain (default: zoho.com for US)
# Other options: zoho.eu, zoho.in, zoho.com.cn, zoho.com.au, zoho.jp
ZOHO_DOMAIN=zoho.com

# Pipeline name in Bigin (default: "Pipeline" — check your Bigin settings)
BIGIN_PIPELINE_NAME=Pipeline
