# Validation harness — SL10 pilot connection
# Copy to .env and fill in if your pilot or password differ.

# REST API V2 root
SYTELINE_BASE_URL=http://s10dev.salinavortex.com/IDORequestService/ido

# Default site config name (used in /token/{config} URLs)
DEFAULT_SITE=Pilot_Vortx

# Claude agent users on the pilot — Automation-licensed super-users for AI use only
# validate_all.py rotates SYTELINE_AGENT_USERNAME across claude1..claude5 itself,
# so this value is only used when running validate_skill.py directly.
SYTELINE_AGENT_USERNAME=claude1
SYTELINE_AGENT_PASSWORD=claude
