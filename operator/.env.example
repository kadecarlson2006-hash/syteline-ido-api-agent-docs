# Operator BACKEND environment (Milestone 4+). Copy to .env — git-ignored. Never commit secrets.
# The Android app does not read this file.

# Provider credentials (backend-only)
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=

# Model routing
OPERATOR_FAST_MODEL_ID=
OPERATOR_DEEP_MODEL_ID=
OPERATOR_DECISION_MODEL_ID=
OPERATOR_VISION_MODEL_ID=

# Voice
OPERATOR_TTS_PROVIDER=elevenlabs
OPERATOR_ELEVENLABS_VOICE_ID=
OPERATOR_ELEVENLABS_MODEL_ID=

# Memory database (Milestone 5)
DATABASE_URL=postgresql://operator:operator@localhost:5432/operator

# Behaviour
OPERATOR_DEFAULT_MODE=STANDBY
OPERATOR_DEFAULT_WIT=NORMAL
ROLLING_CONTEXT_SECONDS=60
MIN_COMMENT_INTERVAL_SECONDS=45
MAX_COMMENTS_PER_5_MINUTES=3
